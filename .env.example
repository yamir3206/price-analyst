# Backend runtime
PRICE_ANALYST_ENVIRONMENT=development
PRICE_ANALYST_HOST=0.0.0.0
PRICE_ANALYST_PORT=8000
PRICE_ANALYST_DATABASE_URL=sqlite:///./price_analyst.db
PRICE_ANALYST_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Gemini is intentionally server-side only. Leave empty to disable AI analysis.
PRICE_ANALYST_GEMINI_API_KEY=
PRICE_ANALYST_GEMINI_MODEL=gemini-2.0-flash
PRICE_ANALYST_MAX_GEMINI_INPUT_TOKENS=4000
PRICE_ANALYST_MAX_GEMINI_OUTPUT_TOKENS=1000
PRICE_ANALYST_MAX_OFFERS_TO_ANALYZE=30
PRICE_ANALYST_GEMINI_TIMEOUT_SECONDS=20
PRICE_ANALYST_ANALYSIS_VERSION=1

# Enable only after reviewing the source policy and network access.
PRICE_ANALYST_TOROB_ENABLED=false
PRICE_ANALYST_TOROB_BASE_URL=https://torob.com
PRICE_ANALYST_SOURCE_TIMEOUT_SECONDS=10
PRICE_ANALYST_MAX_SEARCH_CANDIDATES=100
PRICE_ANALYST_MAX_DETAIL_CANDIDATES=8
PRICE_ANALYST_SOURCE_CONCURRENCY=2
