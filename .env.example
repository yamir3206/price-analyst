# Backend runtime
PRICE_ANALYST_ENVIRONMENT=development
PRICE_ANALYST_HOST=0.0.0.0
PRICE_ANALYST_PORT=8000
PRICE_ANALYST_DATABASE_URL=sqlite:///./price_analyst.db
PRICE_ANALYST_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Gemini is intentionally server-side only. Leave empty to disable AI analysis.
PRICE_ANALYST_GEMINI_API_KEY=
PRICE_ANALYST_GEMINI_MODEL=gemini-2.0-flash
PRICE_ANALYST_MAX_GEMINI_INPUT_TOKENS=4000
PRICE_ANALYST_MAX_GEMINI_OUTPUT_TOKENS=1000
PRICE_ANALYST_MAX_OFFERS_TO_ANALYZE=30
PRICE_ANALYST_GEMINI_TIMEOUT_SECONDS=20
PRICE_ANALYST_GEMINI_CACHE_TTL_SECONDS=3600
PRICE_ANALYST_GEMINI_CACHE_MAX_ENTRIES=256
PRICE_ANALYST_GEMINI_CONCURRENCY=2
PRICE_ANALYST_GEMINI_MIN_INTERVAL_SECONDS=0
PRICE_ANALYST_ANALYSIS_VERSION=2

# Deterministic collection controls
PRICE_ANALYST_SOURCE_TIMEOUT_SECONDS=10
PRICE_ANALYST_MAX_SEARCH_CANDIDATES=100
PRICE_ANALYST_MAX_DETAIL_CANDIDATES=8
PRICE_ANALYST_SOURCE_CONCURRENCY=2
PRICE_ANALYST_SOURCE_MIN_INTERVAL_SECONDS=0.25
PRICE_ANALYST_SOURCE_FAILURE_THRESHOLD=3
PRICE_ANALYST_SOURCE_COOLDOWN_SECONDS=300
PRICE_ANALYST_RETRY_MAX_ATTEMPTS=3
PRICE_ANALYST_RETRY_BASE_DELAY_SECONDS=0.25
PRICE_ANALYST_RETRY_MAX_DELAY_SECONDS=2
PRICE_ANALYST_SNAPSHOT_CACHE_TTL_SECONDS=300
# Enable only after applying Alembic migrations; keeps deterministic snapshots across restarts.
PRICE_ANALYST_DURABLE_CACHE_ENABLED=false
PRICE_ANALYST_DURABLE_CACHE_MAX_ENTRIES=1000
PRICE_ANALYST_ANALYSIS_MATCH_THRESHOLD=0.55
PRICE_ANALYST_ANALYSIS_MAX_OPPORTUNITIES=20

# Enable only after reviewing source terms, robots directives, and network access.
PRICE_ANALYST_TOROB_ENABLED=false
PRICE_ANALYST_TOROB_BASE_URL=https://torob.com
PRICE_ANALYST_BASALAM_ENABLED=false
PRICE_ANALYST_BASALAM_BASE_URL=https://basalam.com
PRICE_ANALYST_DIGIKALA_ENABLED=false
PRICE_ANALYST_DIGIKALA_BASE_URL=https://www.digikala.com
PRICE_ANALYST_DIVAR_ENABLED=false
PRICE_ANALYST_DIVAR_BASE_URL=https://divar.ir
PRICE_ANALYST_DIVAR_CITY=tehran
PRICE_ANALYST_DIVAR_CATEGORY=electronic-devices

# Wholesale uses only an explicitly reviewed public HTTPS JSON feed.
PRICE_ANALYST_WHOLESALE_FEED_ENABLED=false
PRICE_ANALYST_WHOLESALE_FEED_URL=
PRICE_ANALYST_WHOLESALE_FEED_SOURCE=configured_public_feed
PRICE_ANALYST_WHOLESALE_RESPONSE_MAX_BYTES=1000000
PRICE_ANALYST_MAX_WHOLESALE_LISTINGS=100
PRICE_ANALYST_WHOLESALE_CONCURRENCY=2
PRICE_ANALYST_WHOLESALE_MIN_INTERVAL_SECONDS=0.25
PRICE_ANALYST_WHOLESALE_TIMEOUT_SECONDS=10
